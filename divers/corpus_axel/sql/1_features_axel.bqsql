-- ============================================================================
-- 1. Les caractéristiques des avis du corpus d'Axel
-- Table écrite : client-divers.reviewflowz.reviews_panel_features_axel
--
-- C'est `logistic-regression-study/sql/03B_adding_features.bqsql`, à partir de
-- sa ligne 175, avec deux lignes changées :
--   la table écrite    reviews_panel_features_03B  ->  reviews_panel_features_axel
--   la table lue       03B_reviews_panel_filtered_08_04_to_08_26  ->  corpus_axel
--
-- Pour le vérifier :
--   diff <(sed -n '175,$p' logistic-regression-study/sql/03B_adding_features.bqsql) \
--        <(sed -n '/^CREATE OR REPLACE/,$p' divers/corpus_axel/sql/1_features_axel.bqsql)
--
-- Les commentaires de la requête décrivent 03B. Deux ne tiennent plus ici :
--   - « aucun avis du panel n'entre dans sa propre habitude de fiche » : les
--     avis supprimés ajoutés, publiés du 2025-08-11 au 2026-08-03, y entrent ;
--   - l'âge à la première observation « de 0 à 7 jours » : un avis ancien
--     ajouté a plusieurs années le jour où le robot le voit.
-- ============================================================================

CREATE OR REPLACE TABLE `client-divers`.reviewflowz.reviews_panel_features_axel AS

WITH
-- ---------------------------------------------------------------------------
-- Les deux dates de référence du suivi, écrites une seule fois.
--   vague 1      premier passage du robot
--   dernière     dernier passage, qui ferme la fenêtre d'observation
-- ---------------------------------------------------------------------------
bornes AS (
  SELECT DATE "2026-08-11" AS vague1, DATE "2026-08-24" AS derniere_vague
),

-- ---------------------------------------------------------------------------
-- Le panel, avec ses dates en clair. `03B` ne porte que des horodatages ;
-- BigQuery les convertit en date sur UTC, comme le faisait `01_selection`.
-- ---------------------------------------------------------------------------
panel AS (
  SELECT
    p.review_id,
    p.cid,
    p.review_link,
    p.star,
    p.text,
    p.`language`,
    p.n_photos,
    p.reviewer_review_count,
    p.reviewer_photo_count,
    p.local_guide_level,
    p.reply_date,
    p.is_update,
    p.changed_fields,
    CAST(p.created_at AS DATE)          AS created_at_day,
    CAST(p.first_seen_at AS DATE)       AS first_seen_at_day,
    CAST(p.last_seen_at AS DATE)        AS last_seen_at_day,
    CAST(p.deleted_detected_at AS DATE) AS deleted_detected_at_day
  FROM `client-divers`.reviewflowz.corpus_axel p
),

-- ---------------------------------------------------------------------------
-- Socle historique : tous les avis du corpus, une ligne chacun, sur TOUTE la
-- période couverte par l'export. Les profils d'auteur et de fiche en ont
-- besoin, le panel ne couvrant que quatorze jours de publication.
-- ---------------------------------------------------------------------------
corpus_unique AS (
  SELECT
    r.review_id,
    r.cid,
    r.review_link,
    r.`language`,
    r.reply_date,
    CAST(r.created_at AS DATE) AS jour
  FROM `client-divers`.reviewflowz.01_reviews_avis_update_et_unique r
),

-- ---------------------------------------------------------------------------
-- B. Activité de l'auteur, par jour, sur tout le corpus.
-- ---------------------------------------------------------------------------
auteur_jour AS (
  SELECT review_link, jour, COUNT(*) AS n_avis_ce_jour
  FROM corpus_unique
  WHERE review_link IS NOT NULL
  GROUP BY review_link, jour
),

-- ---------------------------------------------------------------------------
-- E. Avis déposés le même jour sur une fiche, sur tout le corpus.
-- ---------------------------------------------------------------------------
fiche_jour AS (
  SELECT cid, jour, COUNT(*) AS n_avis_ce_jour
  FROM corpus_unique
  GROUP BY cid, jour
),

-- ---------------------------------------------------------------------------
-- E. Rythme habituel de chaque fiche : moyenne journalière sur les 365 jours
--    qui précèdent la vague 1. Gelée, identique pour tous les avis de la
--    fiche, et antérieure à toute la fenêtre d'étude.
--
--    Limite à écrire : un avis supprimé avant le 2026-08-11 n'est dans aucune
--    table, le robot ayant découvert le corpus à cette date. Cette moyenne est
--    donc calculée sur les seuls avis SURVIVANTS de la période, et sous-estime
--    le rythme réel des fiches ayant subi des purges anciennes.
-- ---------------------------------------------------------------------------
rythme_fiche AS (
  SELECT
    cid,
    COUNT(*) / 365.0 AS avis_par_jour_avant_vague1
  FROM corpus_unique, bornes
  WHERE jour BETWEEN DATE_SUB(bornes.vague1, INTERVAL 365 DAY)
                 AND DATE_SUB(bornes.vague1, INTERVAL 1 DAY)
  GROUP BY cid
),

-- ---------------------------------------------------------------------------
-- E bis. Habitude de réponse de la fiche, gelée avant la vague 1.
--
--    Avis comptés : publiés du 2025-08-11 au 2026-08-03. Chacun a eu au moins
--    8 jours pour recevoir sa réponse avant l'arrivée du robot, sans quoi un
--    avis de la veille ferait passer une fiche qui répond à tout, avec un jour
--    de délai, pour une fiche qui répond moins.
--    Réponses comptées : datées d'avant le 2026-08-11.
--
--    La borne haute du 2026-08-03 tombe la veille du premier avis du panel,
--    donc aucun avis du panel n'entre dans sa propre habitude de fiche.
--
--    Même limite que `rythme_fiche` : calculée sur les seuls avis survivants.
--    Une réponse retirée est invisible.
-- ---------------------------------------------------------------------------
habitude_reponse_fiche AS (
  SELECT
    cid,
    COUNT(*) AS n_avis,
    COUNTIF(reply_date IS NOT NULL
            AND CAST(reply_date AS DATE) < DATE "2026-08-11") / COUNT(*) AS taux
  FROM corpus_unique
  WHERE jour BETWEEN DATE "2025-08-11" AND DATE "2026-08-03"
  GROUP BY cid
),

-- ---------------------------------------------------------------------------
-- C. Langue habituelle de la fiche, gelée elle aussi sur l'avant-vague 1.
-- ---------------------------------------------------------------------------
langue_modale_fiche AS (
  SELECT cid, `language` AS langue_modale
  FROM (
    SELECT
      cid,
      `language`,
      ROW_NUMBER() OVER (
        PARTITION BY cid ORDER BY COUNT(*) DESC, `language`
      ) AS rn
    FROM corpus_unique
    WHERE `language` IS NOT NULL
      AND jour < DATE "2026-08-11"
    GROUP BY cid, `language`
  )
  WHERE rn = 1
),

-- ---------------------------------------------------------------------------
-- B. Le passé de l'auteur, arrêté à la VEILLE de l'avis examiné.
--    Fenêtre de 90 jours, reprise de `03`.
-- ---------------------------------------------------------------------------
profil_auteur AS (
  SELECT
    p.review_id,
    COUNT(cu.review_id)    AS avis_auteur_90j_avant,
    COUNT(DISTINCT cu.cid) AS fiches_auteur_90j_avant
  FROM panel p
  LEFT JOIN corpus_unique cu
    ON  cu.review_link = p.review_link
    AND cu.jour <  p.created_at_day
    AND cu.jour >= DATE_SUB(p.created_at_day, INTERVAL 90 DAY)
  GROUP BY p.review_id
),

record_auteur AS (
  SELECT
    p.review_id,
    COALESCE(MAX(aj.n_avis_ce_jour), 0) AS max_avis_meme_jour_avant
  FROM panel p
  LEFT JOIN auteur_jour aj
    ON  aj.review_link = p.review_link
    AND aj.jour <  p.created_at_day
    AND aj.jour >= DATE_SUB(p.created_at_day, INTERVAL 90 DAY)
  GROUP BY p.review_id
)

SELECT
  -- =========================================================================
  -- Identifiants
  -- =========================================================================
  p.review_id,
  p.cid,
  CAST(FARM_FINGERPRINT(p.review_link) AS STRING) AS author_key,

  -- =========================================================================
  -- Cible et exposition. Ce ne sont PAS des variables d'entrée du modèle,
  -- sauf les deux dernières — voir l'en-tête.
  -- =========================================================================
  p.deleted_detected_at_day IS NOT NULL AS supprime,
  DATE_DIFF(p.deleted_detected_at_day, p.created_at_day, DAY)
                                                   AS age_a_la_suppression_j,
  DATE_DIFF(p.deleted_detected_at_day, p.first_seen_at_day, DAY)
                                                   AS jours_avant_disparition_j,

  -- Âge de l'avis le jour où le robot l'a vu pour la première fois, de 0 à
  -- 7 jours. C'est le contrôle d'âge de ce panel.
  DATE_DIFF(p.first_seen_at_day, p.created_at_day, DAY)
                                                   AS age_a_la_premiere_observation_j,

  -- Nombre de jours pendant lesquels l'avis pouvait être vu disparaître. Ne
  -- dépend pas de son sort, donc utilisable en entrée. Voir l'en-tête § 3.
  DATE_DIFF(bornes.derniere_vague, p.first_seen_at_day, DAY)
                                                   AS fenetre_observation_j,

  p.created_at_day,
  p.first_seen_at_day,
  (p.created_at_day >= bornes.vague1)              AS ne_pendant_la_surveillance,

  -- =========================================================================
  -- A. L'avis
  -- =========================================================================
  p.star,
  (p.text IS NOT NULL AND LENGTH(TRIM(p.text)) > 0) AS has_text,
  COALESCE(LENGTH(p.text), 0)                       AS text_chars,
  p.n_photos,
  (p.n_photos > 0)                                  AS has_photo,

  -- L'avis a été réécrit par son auteur. Mesurable pour la première fois sur
  -- cette chaîne de tables : voir l'en-tête § 4. À lire à part, pas en entrée
  -- d'un modèle qui prédit.
  COALESCE(p.is_update, FALSE)                      AS avis_modifie,
  COALESCE(p.changed_fields LIKE "%star%", FALSE)   AS note_modifiee,
  COALESCE(p.changed_fields LIKE "%text%", FALSE)   AS texte_modifiee,

  -- =========================================================================
  -- A. La réponse du commerçant, datée.
  --
  --   `reponse_avant_surveillance` est figée avant que la période de risque
  --   commence, donc elle ne peut pas être une conséquence de la survie.
  --
  --   `reponse_pendant_surveillance` arrive pendant la période de risque : à
  --   écarter du modèle ou à traiter à part.
  --
  --   `reponse_dans_les_2_jours` porte ici sur bien plus d'avis qu'en `03` :
  --   la moitié du panel naît pendant la surveillance.
  -- =========================================================================
  (p.reply_date IS NOT NULL)                                    AS a_une_reponse,
  (p.reply_date IS NOT NULL
   AND CAST(p.reply_date AS DATE) <  p.first_seen_at_day)       AS reponse_avant_surveillance,
  (p.reply_date IS NOT NULL
   AND CAST(p.reply_date AS DATE) >= p.first_seen_at_day)       AS reponse_pendant_surveillance,
  DATE_DIFF(CAST(p.reply_date AS DATE), p.created_at_day, DAY)  AS delai_reponse_j,
  (p.reply_date IS NOT NULL
   AND DATE_DIFF(CAST(p.reply_date AS DATE), p.created_at_day, DAY) <= 2)
                                                                AS reponse_dans_les_2_jours,

  -- =========================================================================
  -- B. L'auteur
  -- =========================================================================
  p.reviewer_review_count,
  LN(p.reviewer_review_count + 1)          AS log_rc,
  (p.reviewer_review_count = 0)            AS rc_zero,
  p.local_guide_level,
  (p.local_guide_level IS NULL)            AS lg_level_missing,

  -- Palier Local Guide, trois valeurs. Repris de `03`.
  CASE
    WHEN p.local_guide_level IS NULL              THEN "sans_niveau"
    WHEN p.local_guide_level <= 3                 THEN "1_3"
    ELSE                                               "4_et_plus"
  END                                      AS palier_local_guide,

  -- Photos publiées par l'auteur sur son profil. Vide mis à 0, décision de
  -- Romain du 2026-09-17.
  COALESCE(p.reviewer_photo_count, 0)      AS reviewer_photo_count,

  -- Avis publiés par le même auteur le MÊME JOUR, sur tout le corpus.
  -- Ce n'est pas une information du futur : ces avis existent au même moment,
  -- la suppression vient plusieurs jours plus tard.
  COALESCE(aja.n_avis_ce_jour, 1)          AS n_avis_meme_jour_auteur,

  -- Passé de l'auteur, arrêté à la veille de cet avis.
  -- Réserve : la quasi-totalité de ces compteurs vaut zéro. Le corpus ne
  -- couvre que 9 048 commerces, donc on ne voit d'un auteur que la part de son
  -- activité qui tombe sur ces fiches.
  pa.avis_auteur_90j_avant,
  pa.fiches_auteur_90j_avant,
  ra.max_avis_meme_jour_avant,

  -- =========================================================================
  -- C. La langue
  -- =========================================================================
  p.`language`,
  (p.`language` IS NULL) AS langue_inconnue,

  -- Étrangère si la langue ne figure pas parmi celles du pays, quel que soit
  -- leur rang. Le français en Belgique est une langue du pays, en rang 2.
  -- Ne pas citer cette colonne : en Europe elle mesure le tourisme.
  (p.`language` IS NOT NULL
   AND NOT EXISTS (
     SELECT 1
     FROM `client-divers`.reviewflowz.concordance_pays_langue k
     WHERE k.code_pays   = b.country
       AND k.code_langue = p.`language`
   ))                                      AS langue_etrangere_au_pays,

  (p.`language` IS NOT NULL
   AND lm.langue_modale IS NOT NULL
   AND p.`language` != lm.langue_modale)   AS langue_minoritaire_sur_la_fiche,

  -- =========================================================================
  -- D. L'établissement
  -- =========================================================================
  b.industry,
  b.country,
  b.bucket,

  IF(b.country = "US", "US", "Europe")     AS region,

  -- Les quatre chaînes antiparasitaires américaines, et les deux salles de
  -- sport espagnoles attaquées. Elles restent dans le corpus ; le drapeau sert
  -- à relancer les modèles sans elles.
  --
  -- RÉSERVE MESURÉE LE 2026-09-18 : ce drapeau marque sur une égalité exacte
  -- de nom. Les fiches « EcoShield Pest Solutions Seattle », « Bulwark
  -- Exterminating Corporate » et « Insight Pest Control » lui échappent, et
  -- 66 autres fiches de traitement antiparasitaire restent hors du drapeau.
  -- Voir `etudes-ponctuelles/2026-09-18-antiparasitaire-home-services/sorties/2026-09-18-antiparasitaire-home-services-us.docx`.
  (b.name IN ("EcoShield Pest Solutions", "Insight Pest Solutions",
              "Pointe Pest Control", "Bulwark Exterminating"))
                                           AS chaine_antiparasitaire_us,
  (b.name IN ("Boutique The Boxer Club Dr Castelo", "The Boxer Club"))
                                           AS salle_de_sport_attaquee,

  -- =========================================================================
  -- E. L'afflux d'avis sur la fiche le jour du dépôt
  -- =========================================================================
  fj.n_avis_ce_jour                        AS n_avis_meme_jour_fiche,
  rf.avis_par_jour_avant_vague1            AS rythme_fiche_avant_vague1,
  (rf.avis_par_jour_avant_vague1 IS NULL)  AS rythme_fiche_inconnu,
  SAFE_DIVIDE(fj.n_avis_ce_jour, rf.avis_par_jour_avant_vague1)
                                           AS ratio_pic_journalier_fiche,
  LN(SAFE_DIVIDE(fj.n_avis_ce_jour, rf.avis_par_jour_avant_vague1) + 1)
                                           AS log_ratio_pic_journalier_fiche,

  -- Habitude de réponse de la fiche. Vide sous 10 avis sur la période.
  COALESCE(hr.n_avis, 0)                   AS n_avis_historique_reponse_fiche,
  IF(COALESCE(hr.n_avis, 0) >= 10, hr.taux, NULL)
                                           AS taux_reponse_fiche_avant_vague1

FROM panel p
CROSS JOIN bornes
LEFT JOIN `client-divers`.reviewflowz.businesses b ON p.cid = b.cid
LEFT JOIN langue_modale_fiche lm ON p.cid = lm.cid
LEFT JOIN rythme_fiche        rf ON p.cid = rf.cid
LEFT JOIN habitude_reponse_fiche hr ON p.cid = hr.cid
LEFT JOIN fiche_jour          fj ON p.cid = fj.cid AND p.created_at_day = fj.jour
LEFT JOIN profil_auteur       pa ON p.review_id = pa.review_id
LEFT JOIN record_auteur       ra ON p.review_id = ra.review_id
LEFT JOIN auteur_jour         aja ON aja.review_link = p.review_link
                                 AND aja.jour        = p.created_at_day;
