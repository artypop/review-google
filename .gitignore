# Données : volumineuses et contenant des données personnelles (reviewer_name,
# review_link, text). Le README de l'export interdit la rediffusion.
data/
# Lien vers ../data, que les scripts de etude-exploratoire/ attendent dans leur
# propre répertoire. Créé par : ln -sfn ../data etude-exploratoire/data
etude-exploratoire/data
.venv/
__pycache__/
*.pyc

# Configuration de l'agent : `.claude/settings.json` est partagé et versionné.
# Les permissions propres à une machine vont dans `settings.local.json`, qui ne
# l'est pas — sinon chacun écrase les réglages des autres.
.claude/settings.local.json

# Réglages de l'éditeur, propres à une machine.
.vscode/
